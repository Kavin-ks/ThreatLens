# ThreatLens Backend Configuration
# Copy this file to .env and fill in appropriate values.
# NEVER commit .env to version control.

# ----- Application -----
DEBUG=true
APP_NAME=ThreatLens
APP_VERSION=0.1.0

# ----- Database -----
# SQLite (default for development — no setup required)
DATABASE_URL=sqlite:///./threatlens.db

# PostgreSQL (production / Docker)
# DATABASE_URL=postgresql://threatlens:your_password@localhost:5432/threatlens

# ----- Redis / Celery -----
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ----- Security -----
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE-THIS-IN-PRODUCTION-USE-A-STRONG-RANDOM-KEY
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ----- CORS -----
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ----- Evidence Storage -----
EVIDENCE_STORE_PATH=./evidence_store

# ----- Feature Flags -----
# Dynamic scanning requires a running target app; disabled by default
ENABLE_DYNAMIC_SCANNING=false
# AI-assisted triage; requires Anthropic API key
ENABLE_AI_TRIAGE=false
# ANTHROPIC_API_KEY=your-key-here
